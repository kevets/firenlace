---
import BaseLayout from '../layouts/BaseLayout.astro';

const primalProfile =
  'https://primal.net/p/nprofile1qqstl4ze9gew53p9j9yffxjguenjyxexz5vghymws4rrs0w3wvz3epcwf434q';
---

<BaseLayout>
  <main>

    <header class="hero">
      <div class="flower">✦</div>

      <h1 class="script">Fire &amp; Lace</h1>

      <p class="motto">
        Love · Faith · Spirit · Beauty · Wisdom
      </p>

      <p class="intro">
        A personal journal of simple reflections, meaningful living,
        and finding beauty in the everyday.
      </p>
    </header>

    <section class="content">

      <div class="column">
        <div class="section-heading">
          <span class="script">The Living Fire</span>
          <h2>Primal</h2>
        </div>

        <div class="primal-card">

          <div class="primal-mark">✦</div>

          <h3>Fire &amp; Lace on Nostr</h3>

          <p>
            Follow the latest posts, conversations, and reflections
            directly through Primal.
          </p>

          <a
            class="button"
            href={primalProfile}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open Fire &amp; Lace in Primal ↗
          </a>

        </div>
      </div>


      <div class="column">
        <div class="section-heading">
          <span class="script">The Written Word</span>
          <h2>Reflections</h2>
        </div>

        <div class="article-card">

          <p class="eyebrow">
            NIP-23 · LONG-FORM
          </p>

          <h3>Begin Again</h3>

          <p>
            Sometimes wellness is simply remembering to slow down.
          </p>

          <p>
            Take a breath. Step outside. Notice the light.
            Say a prayer. Call someone you love.
          </p>

          <a class="read-link" href="/articles/begin-again/">
            Read reflection →
          </a>

        </div>
      </div>

    </section>

  </main>
</BaseLayout>
