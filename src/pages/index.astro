---
const primalProfile =
  'https://primal.net/p/nprofile1qqstl4ze9gew53p9j9yffxjguenjyxexz5vghymws4rrs0w3wvz3epcwf434q#reads';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Fire & Lace</title>

    <meta
      name="description"
      content="Love, faith, spirit, beauty, and wisdom."
    />
  </head>

  <body>

    <main>

      <header class="hero">
        <div class="flower">✦</div>

        <h1>Fire &amp; Lace</h1>

        <p class="motto">
          Love · Faith · Spirit · Beauty · Wisdom
        </p>

        <p class="intro">
          A personal journal of simple reflections,
          meaningful living, and finding beauty in the everyday.
        </p>
      </header>


      <section class="content">

        <!-- PRIMAL -->

        <div class="column">

          <div class="section-heading">
            <span>The Living Fire</span>
            <h2>Primal</h2>
          </div>

          <div class="primal-card">

            <div class="primal-mark">✦</div>

            <h3>Fire &amp; Lace on Nostr</h3>

            <p>
              Follow posts, conversations, and reflections
              through Primal.
            </p>

            <a
              class="button"
              href={primalProfile}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Primal ↗
            </a>

          </div>

        </div>


        <!-- ARTICLES -->

        <div class="column">

          <div class="section-heading">
            <span>The Written Word</span>
            <h2>Reflections</h2>
          </div>

          <div class="article-card">

            <p class="eyebrow">
              NIP-23 · LONG-FORM
            </p>

            <h3>Begin Again</h3>

            <p>
              Sometimes wellness is simply remembering
              to slow down.
            </p>

            <p>
              Take a breath. Step outside. Notice the light.
              Say a prayer. Call someone you love.
            </p>

            <a class="read-link" href="#">
              Read reflection →
            </a>

          </div>

        </div>

      </section>

    </main>

  </body>
</html>
